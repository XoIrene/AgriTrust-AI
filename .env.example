# ---------------------------------------------------------------------------
# AgriTrust AI - environment configuration
# Copy to .env and edit. NEVER commit the real .env file.
# ---------------------------------------------------------------------------

# --- Application ---
APP_NAME="AgriTrust AI"
APP_ENV=development          # development | production
DEBUG=true
SECRET_KEY=change-me-to-a-long-random-string
API_V1_PREFIX=/api/v1

# --- Which address the server answers on ---
# The app serves its own HTML, CSS, JS and API from the same origin using relative
# URLs, so it works on any hostname with no code change. Only these two things
# need to know the address:
#
#   HOST / PORT   read by scripts/run.sh, not by FastAPI.
#                 HOST=0.0.0.0 listens on every network interface, so the same
#                 build is also served at http://<your-lan-ip>:8000 for testing on
#                 a real phone. The default 127.0.0.1 is this computer only.
#   PUBLIC_BASE_URL   baked into payment QR codes so a phone can open them.
#
# To use your own name instead of 127.0.0.1:8000, e.g. agritrust.local:
#   1. add the name to /etc/hosts:  127.0.0.1  agritrust.local
#   2. run:  HOST=0.0.0.0 ./scripts/run.sh
#   3. open http://agritrust.local:8000
# For a public address, point a tunnel (cloudflared / ngrok) at the port and put
# the https URL in PUBLIC_BASE_URL.
HOST=127.0.0.1
PORT=8000

# --- Database (MariaDB / MySQL) ---
DATABASE_URL=mysql+pymysql://agritrust:agritrust_dev_pw@localhost:3306/agritrust?charset=utf8mb4
TEST_DATABASE_URL=mysql+pymysql://agritrust:agritrust_dev_pw@localhost:3306/agritrust_test?charset=utf8mb4
# SQLite fallback (local demo only, no setup required)
# DATABASE_URL=sqlite:///./agritrust.db
# TEST_DATABASE_URL=sqlite:///./agritrust_test.db.db

# --- Security / JWT ---
JWT_SECRET_KEY=change-me-too-to-a-different-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=14
LOGIN_RATE_LIMIT=10
PASSWORD_MIN_LENGTH=8
DATA_ENCRYPTION_KEY=change-me-32-byte-base64-or-passphrase

# --- CORS (comma separated) ---
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# --- Demo / mock mode ---
# true  = weather/market/payments/SMS use clearly-labelled demo providers
# false = attempt real providers (requires the credentials below)
MOCK_MODE=true
DEMO_MODE=true

# --- Africa's Talking (SMS + USSD) ---
# SMS and USSD go live only when MOCK_MODE=false AND a real API key is set;
# otherwise every SMS is recorded locally (Admin > SMS log) and nothing is sent.
# Setup steps: README.md > "Africa's Talking: SMS and USSD".
#   sandbox     username must be "sandbox"; use the API key generated in the
#               sandbox app. Messages appear in the AT simulator, not on phones.
#   production  your live app's username and API key.
AFRICASTALKING_USERNAME=sandbox
AFRICASTALKING_API_KEY=your_key_here
AFRICASTALKING_ENV=sandbox        # sandbox | production
# Leave empty to use the gateway's default sender. Set only an alphanumeric
# sender id or short code that is approved on your account (else: InvalidSenderId).
AFRICASTALKING_SENDER_ID=
AFRICASTALKING_SHORTCODE=
AFRICASTALKING_USSD_CODE=*384*1234#   # the USSD code your AT channel is assigned
# The public URLs to register in the Africa's Talking dashboard:
#   USSD callback          <PUBLIC_BASE_URL>/api/v1/ussd/callback
#   SMS delivery reports   <PUBLIC_BASE_URL>/api/v1/sms/delivery-report
AFRICASTALKING_CALLBACK_URL=https://your-tunnel.example/api/v1/ussd/callback
# Optional shared secret. When set, append ?token=<value> to both callback URLs
# in the dashboard; requests without it are refused with 403.
AFRICASTALKING_CALLBACK_TOKEN=

# --- Weather provider ---
WEATHER_PROVIDER=openmeteo            # mock | openmeteo
OPENMETEO_BASE_URL=https://api.open-meteo.com/v1/forecast
WEATHER_API_KEY=

# --- Market price provider ---
MARKET_PROVIDER=mock             # mock | api
MARKET_API_URL=
MARKET_API_KEY=

# --- Payment / financial integration providers ---
# Address phones can reach for payment QR codes (your LAN IP when demoing on a phone).
PUBLIC_BASE_URL=
PAYMENT_REQUEST_MINUTES=30
PAYMENT_PROVIDER=mock            # mock | africastalking
AFRICASTALKING_PAYMENT_PRODUCT=Telecom
AFRICASTALKING_PAYMENT_TARGET=+255000000000
AFRICASTALKING_PAYMENT_CURRENCY=TZS

# --- LLM (AI assistant + explanation layer) ---
# provider: anthropic | ollama | offline
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=your_key_here
# the assistant's chat model; anything starting with "claude" is used as-is
LLM_MODEL=claude-sonnet-4-6
ANTHROPIC_MODEL=claude-sonnet-4-6
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1
LLM_TIMEOUT_SECONDS=30
LLM_TEMPERATURE=0.2

# --- ML models ---
ML_MODEL_DIR=./ml/credit_risk
CREDIT_RISK_MIN_TRAIN_SAMPLES=150

# --- Identity verification (NIDA) ---
# Which provider answers "is this national ID a real, registered identity?".
#   mock  = a clearly labelled test double with dummy numbers. Nothing is
#           verified against any registry and the UI says so on screen.
#   nida  = the real adapter. It refuses to run without NIDA_API_BASE_URL and
#           NIDA_API_KEY, so it can never silently fall back to pretending.
IDENTITY_PROVIDER=mock
# Identity verification is a single on/off switch for the whole feature.
#   false - the registration page shows no identity section, and /auth/register
#           does not ask for a verified identity (plain form, as before)
#   true  - the NIDA section is rendered and a verified identity is required to
#           create an account
# The endpoints, provider adapters, table and tests all stay in place either
# way, so this can be flipped without a code change.
IDENTITY_REQUIRED=false
# Which roles must verify a national ID, comma separated. A farmer signs up as
# themselves, so FARMER is the default. A buyer or an officer is onboarded by
# the institution they act for, so demanding a national ID there would block a
# legitimate signup for an identity onboarding never uses.
IDENTITY_REQUIRED_ROLES=FARMER
# Accepted NIDA lengths, comma separated. Tanzania has issued more than one
# format: 16 digits on the legacy scheme, 20 on the current one. Add a length
# here rather than editing code if NIDA ever introduces another.
IDENTITY_NIDA_LENGTHS=16,20
# --- only read by IDENTITY_PROVIDER=nida ---
NIDA_API_BASE_URL=
NIDA_API_KEY=
NIDA_TIMEOUT_SECONDS=20
# NIDA lookups allowed per window, counted per IP and per phone number
IDENTITY_VERIFY_RATE_LIMIT=5
IDENTITY_VERIFY_RATE_WINDOW_SECONDS=600
# phone OTP that follows a successful NIDA check
IDENTITY_OTP_TTL_SECONDS=300
IDENTITY_OTP_MAX_ATTEMPTS=5
# how long a verified identity stays usable before the account must be created
IDENTITY_SESSION_TTL_MINUTES=30
IDENTITY_TICKET_TTL_MINUTES=15

